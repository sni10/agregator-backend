# Production .env for /srv/renews on the server (next to compose.prod.yaml), chmod 600. Never commit the real file.
# Values marked GENERATE are created on the server, e.g.:  openssl rand -hex 32

# Images to run (commit SHAs): IMAGE_TAG is set by deploy/deploy.sh, FRONT_TAG by agregator-front/deploy/deploy.sh (empty = no front)
IMAGE_TAG=
FRONT_TAG=

# Django. ALLOWED_HOSTS: the API, the admin, and "app" (the front's server render calls http://app:8000)
DJANGO_SECRET_KEY=GENERATE-openssl-rand-base64-48
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.renews.me,secure.renews.me,app

# PostgreSQL (the db service in compose.prod.yaml)
DB_NAME=renews
DB_USER=renews
DB_PASSWORD=GENERATE
DB_HOST=db
DB_PORT=5432

# The front calling the read API from the browser
CORS_ALLOWED_ORIGINS=https://renews.me

STATIC_ROOT=staticfiles

# Story images: the volume renews_media, served by Caddy at api.renews.me/media/
MEDIA_ROOT=media
MEDIA_URL=https://api.renews.me/media/

# Links in sitemap.xml, news-sitemap.xml and rss.xml
SITE_URL=https://renews.me
SITE_NAME=Renews

# The local pipeline's key (X-Api-Key): the same value goes into the pipeline's .env. GENERATE: openssl rand -hex 32
PUBLISHING_API_KEY=GENERATE

# Account emails (confirmation, password reset). console = printed to the app log; production: smtp via Brevo
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=GENERATE-in-Brevo
EMAIL_PASSWORD=GENERATE-in-Brevo
EMAIL_SENDER=Renews <noreply@renews.me>

# POST /contact: messages are emailed here (never shown on the site). Empty = admin only
CONTACT_EMAIL=
# Cloudflare Turnstile secret for the contact form captcha (the site key goes to the front). Empty = always-pass test key
TURNSTILE_SECRET=
