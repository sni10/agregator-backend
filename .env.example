# Copy to .env and fill in. Real environment variables override values from .env.
# Values here are for `uv run manage.py ...` on the host; compose.yaml overrides DB_HOST/DB_PORT for the container.

# Django
DJANGO_SECRET_KEY='change-me-to-a-random-50+-char-string'
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,app

# PostgreSQL (compose service db, published on 127.0.0.1:5434: 5432 is the gallery's, 5433 the pipeline's)
DB_NAME=agregator_site
DB_USER=dev
DB_PASSWORD=dev
DB_HOST=127.0.0.1
DB_PORT=5434

# Front origins allowed to call the read API, comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# collectstatic target (relative paths are resolved against the project root)
STATIC_ROOT=staticfiles

# Publishing API for the local pipeline (/publishing/*, header X-Api-Key). The same key goes into the pipeline's .env.
# Empty = publishing off (403). Generate: openssl rand -hex 32
PUBLISHING_API_KEY=
# Minutes between the stories of one batch: they go live one by one through the day. 0 = all at once
PUBLISHING_SPREAD_MINUTES=0

# Story images: WebP variants made on upload. URL is what the front links to (absolute: the front is another host)
MEDIA_ROOT=media
MEDIA_URL=http://localhost:8002/media/

# The public site (agregator-front): sitemap.xml, news-sitemap.xml and rss.xml link there
SITE_URL=http://localhost:5173
SITE_NAME=Renews

# Account emails (confirmation, password reset). console = printed to the app log; production: smtp via Brevo
EMAIL_BACKEND=console
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SENDER=Renews <noreply@renews.me>

# POST /contact: messages are emailed here (never shown on the site). Empty = admin only
CONTACT_EMAIL=
# Cloudflare Turnstile secret for the contact form captcha (the site key goes to the front). Empty = always-pass test key
TURNSTILE_SECRET=
