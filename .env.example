# Copy to .env and fill in. Real environment variables override values from .env.
# Values here are for `uv run manage.py ...` on the host; compose.yaml overrides DB_HOST/DB_PORT for the container.

# Django
DJANGO_SECRET_KEY='change-me-to-a-random-50+-char-string'
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (compose service db, published on 127.0.0.1:5434: 5432 is the gallery's, 5433 the pipeline's)
DB_NAME=agregator_site
DB_USER=dev
DB_PASSWORD=dev
DB_HOST=127.0.0.1
DB_PORT=5434

# Front origins allowed to call the read API, comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# collectstatic target (relative paths are resolved against the project root)
STATIC_ROOT=staticfiles

# Publishing API for the local pipeline (/publishing/*, header X-Api-Key). The same key goes into the pipeline's .env.
# Empty = publishing off (403). Generate: openssl rand -hex 32
PUBLISHING_API_KEY=
